msgid "HLS: Use inputstream.ffmpegdirect"
msgstr "HLS: Použít inputstream.ffmpegdirect"

msgctxt "#30050"
msgid "Provider/Authentication: Using Waipu (Device Login) is recommended! Do not use credentials login."
msgstr "Poskytovatel / ověření: Doporučuje se použít Waipu (přihlášení zařízení). Nepoužívejte přihlášení pomocí přihlašovacích údajů."

msgctxt "#30051"
msgid "Widevine CDM is required to play non public channels. Click to install Widevine CDM if some channels are not working!"
msgstr "Pro přehrávání neveřejných kanálů je vyžadováno Widevine CDM. Pokud některé kanály nefungují, kliknutím nainstalujte Widevine CDM."

msgctxt "#30052"
msgid "Check whether Widevine CDM is installed. Required to play non public channels."
msgstr "Zkontroluje, zda je nainstalováno Widevine CDM. Je vyžadováno pro přehrávání neveřejných kanálů."

msgctxt "#30053"
msgid "Select streaming protocol. Use AUTO or MPEG_DASH. Do not use HLS, because not all channels support this."
msgstr "Vyberte protokol streamování. Použijte AUTO nebo MPEG_DASH. Nepoužívejte HLS, protože ho nepodporují všechny kanály."

msgctxt "#30054"
msgid "By default, inputstream.adaptive is used for playing HLS. Check this option to use inputstream.ffmpegdirect instead."
msgstr "Ve výchozím stavu se pro přehrávání HLS používá inputstream.adaptive. Zaškrtnutím této volby se místo něj použije inputstream.ffmpegdirect."

msgctxt "#30055"
msgid "Recordings: Load description and year"
msgstr "Nahrávky: načítat popis a rok"

